```gitignore
# Node.js frontend
frontend/node_modules/
frontend/dist/

# Python backend
backend/.venv/
backend/.venv_old/
backend/venv/
backend/__pycache__/
backend/*.pyc

# Environment secrets
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example

# IDE and operating system files
.vscode/
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
```